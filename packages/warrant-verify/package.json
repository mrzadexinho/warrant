{
  "name": "@idriszade/warrant-verify",
  "version": "0.1.0",
  "description": "Independent chain replay, DSSE certificate export and verification, and the warrant-verify CLI.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "warrant-verify": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@idriszade/core": "^0.1.0",
    "@idriszade/warrant-core": "workspace:*",
    "@idriszade/warrant-ledger": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0",
    "fast-check": "^4.4.0"
  }
}
