{
  "name": "@idriszade/warrant-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The MCP tool adapter. Governs an MCP tool call by calling the two existing seams: requestAuthority, then guardedExecute. Structurally typed against MCP tool shapes; no vendor SDK dependency.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@idriszade/core": "^0.1.0",
    "@idriszade/warrant-core": "workspace:*",
    "@idriszade/warrant-authorize": "workspace:*",
    "@idriszade/warrant-guard": "workspace:*",
    "@idriszade/warrant-gatewerk": "workspace:*",
    "@idriszade/warrant-ledger": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@idriszade/warrant-policy": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
