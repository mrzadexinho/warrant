# The ceremony's configuration. Copy to `.env` (gitignored) and fill in.
#
# The authoritative list is `WARRANT_CEREMONY=1 pnpm ceremony preflight`, which names every missing
# variable and refuses to start. This file mirrors that list so the shape is readable without
# running anything.
#
# NEVER put real values in a tracked file. `.env` is gitignored; `.env.example` is not.

# The switch. `1` and nothing else. With it set and anything else wrong, the process refuses to
# start rather than quietly falling back to the demo runtime.
WARRANT_CEREMONY=1

# ── Signing ───────────────────────────────────────────────────────────────────────────────────
# 64 hex chars. Generate with: pnpm ceremony keygen --print-private
# The published demo key is refused BY NAME, so a copy-paste from the docs cannot sign a real run.
# Publish only the public half, in ceremony/README.md.
WARRANT_PRIVATE_KEY_HEX=

# ── Ledger (Postgres, two roles) ──────────────────────────────────────────────────────────────
# The privilege split is the append-only property, not decoration. The app role must hold INSERT
# and SELECT only and must NOT own the table: triggers and REVOKE do not bind the owner, so a
# table owned by the role that writes to it has no append-only guarantee however many triggers
# sit on it. Preflight verifies this against the live database and refuses otherwise.
WARRANT_LEDGER_DATABASE_URL=
WARRANT_LEDGER_ADMIN_DATABASE_URL=
WARRANT_LEDGER_APP_ROLE=

# ── Starting a run ────────────────────────────────────────────────────────────────────────────
# The bearer token for POST /warrant/v1/run, the ONLY route that starts a ceremony run.
#
# `agent/channels/warrant-trigger.ts:20` requires this. The guard is fail-closed
# (`TRIGGER_SECRET === '' -> return null`, so an unset secret CLOSES the route rather than opening
# it) and is covered by tests.
#
# Loaded through config.ts, so preflight refuses a configuration that cannot start a run: "config
# is valid" and "the run will work" are two states preflight must be able to tell apart, the same
# as for GATEWERK_TEMPLATE_SLUG below.
#
# Generate one: `openssl rand -hex 32`. The channel compares it with timingSafeEqual.
WARRANT_TRIGGER_SECRET=

# ── Gatewerk (the human decision) ─────────────────────────────────────────────────────────────
GATEWERK_BASE_URL=
GATEWERK_API_KEY=
GATEWERK_WEBHOOK_SECRET=
# REQUIRED, no default, enforced in config.ts. Only the caller knows which
# Gatewerk template renders its review; a default here is the last domain word in a domain-blind
# package. Both an absent and an EMPTY value are refused.
# Preflight additionally refuses a template that auto-approves, or one carrying any timeout default.
GATEWERK_TEMPLATE_SLUG=

# Where Gatewerk sends the decision webhook. Must be https unless localhost, and must be
# reachable FROM Gatewerk. Gatewerk resolves it when the review is CREATED and refuses a private
# or unresolvable host, so this gates creating a review at all, not merely receiving the
# callback.
#
# A proxy must forward THREE paths, not two:
#   /eve/                        eve's own session routes
#   /.well-known/workflow/       workflow-world resume callbacks; dropping it stalls parked runs silently
#   /warrant/v1/gatewerk/review  THE CALLBACK ITSELF: the literal path config.ts appends to this
#                                variable, and the one Gatewerk actually POSTs to
# eve mounts an authored channel at the exact literal string passed to POST(path, handler) with no
# /<channel-id>/ prefix, so the callback does NOT live under /eve/. A proxy configured from the old
# two-item list answers 404 to every decision Gatewerk delivers.
#
# Simplest correct answer, and what the deployment uses: route by HOST, forwarding all paths. An
# enumerated prefix list has now been wrong twice for the same reason: the list cannot be checked
# against the routes the app actually serves, so a forgotten entry is invisible until a decision is
# dropped in production.
PUBLIC_BASE_URL=

# ── The send ──────────────────────────────────────────────────────────────────────────────────
# This actuator speaks SMTP, and only SMTP. An HTTP email API is a different actuator on a
# different path: pursuit's serve-email-resend, for Resend's HTTP API. Resend's SMTP endpoint,
# on the other hand, works here just fine, and so does Postmark's, SES's, or any other provider's:
# this path is plain SMTP, so which provider sits behind these four variables is a deployment
# decision, not a code one.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WARRANT_CEREMONY_FROM=

# Comma separated. NO DEFAULT, and empty is an error rather than "anyone". Enforced at the send
# boundary (the last gate before a real inbox) rather than in the policy document, which would
# break golden parity. A refusal here is recorded as action.outcome{status:'failed'} and the
# spent nonce is never retried.
WARRANT_CEREMONY_ALLOWED_RECIPIENTS=

# ── The agent ─────────────────────────────────────────────────────────────────────────────────
# Deliberately OpenAI: the same policy, ledger, certificate and verifier already run under the
# Anthropic-based reference runtime, so a second vendor is evidence the neutrality claim covers
# models as well as frameworks. The model is not part of the trust boundary.
OPENAI_API_KEY=
WARRANT_CEREMONY_MODEL=
